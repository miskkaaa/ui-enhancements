{
	"geode": "5.9.0",
	"gd": {
		"win": "2.2081",
		"android": "2.2081",
		"mac": "2.2081",
		"ios": "2.2081"
	},
	"id": "miskaa.ui-enhancements",
	"name": "miskaa's UI enhancements",
	"version": "v1.0.1",
	"developer": "miskaa",
	"description": "Enhances Geometry Dash UI",
	"resources": {
		"sprites": ["resources/*.png"]
	},
	"tags": ["enhancement", "interface", "offline"],
	"dependencies": {
		"geode.node-ids": {"version": ">=v1.23.3","required": true},
		"alphalaneous.alphas-ui-pack": {"version": ">=1.1.1","required": true},
		"thesillydoggo.blur-api": {"version": ">=1.0.0","required": false}
	},
	"settings": {
		"CleanEditorPause": {
			"type": "bool",
			"name": "Enables Clean Editor Pause as long tinker is disabled",
			"description": "",
			"default": true
		},
		"OptionsLayer": {
			"type": "bool",
			"name": "Enables OptionsLayer Enhancements [BUGGY]",
			"description": "Enhancements for the main menu music sliders",
			"default": true
		},
		"GJShopLayer": {
			"type": "bool",
			"name": "Enables enhancements for the shops",
			"default": true
		},
		"CreatorLayer": {
			"type":	"bool",
			"name": "The fucking idk",
			"default": false
		},
		"PauseLayer": {
			"type": "bool",
			"name": "Pause menu",
			"default": true
		},

		"specific": {
			"type": "title",
			"name": "Specific Settings"
		},

		"bottombar": {
			"type": "bool",
			"name": "Bottom bar in Pause menu",
			"default": false
		},
		"thethings": {
			"type": "bool",
			"name": "Enable left and right bar/nineslices on the Pause menu",
			"default": true
		},
		"blur": {
			"type": "bool",
			"name": "Blur",
			"description": "Enables blur in: Pause menu (todo add more)",
			"default": true
		},

		"jokesettings": {
			"type": "title",
			"name": "Joke Settings",
			"description": "Fucking joke settings you already know this"
		},

		"ILoveMapPacks": {
			"type": "bool",
			"name": "Only button for CreatorLayer are MapPacks and the Exit Button",
			"default": true
		}
	}
}